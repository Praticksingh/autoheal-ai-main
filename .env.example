# Frontend (Vite)
# In Vercel, leave VITE_API_URL and VITE_API_BASE_URL empty to use relative /api routes on the same domain.
# For custom external backend API deployment, set VITE_API_URL=https://your-backend-domain.com
VITE_API_URL=
VITE_API_BASE_URL=http://localhost:5000
VITE_SOCKET_URL=http://localhost:5000

# Backend (Express)
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://localhost:27017/autoheal
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=
TEAM_WEBHOOK_URL=
LOG_TO_FILE=false
LOG_FILE_PATH=./server/logs/app.log
GEMINI_API_KEY=